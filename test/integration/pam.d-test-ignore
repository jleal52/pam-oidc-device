# Test service: an unmapped user falls through to the next module.
# success=done  -> an approved login ends the stack successfully
# ignore=ignore -> an unmapped user is passed to the next module
# default=die   -> any other result denies immediately
auth    [success=done ignore=ignore default=die]    pam_oidc_device.so config=/etc/pam_oidc_device.yaml
auth    required    pam_permit.so
account required    pam_permit.so
