# Test PAM stack for sshd: the module first, unmapped users fall through.
#
# config= is spelled out on purpose: this stack exercises the explicit
# argument. Scenario (f) of run.sh covers the other half, a stack without it,
# where the helper resolves /etc/oidc-ssh/config.yaml by itself.
auth     [success=done ignore=ignore default=die]  pam_oidc_ssh.so debug config=/etc/oidc-ssh/config.yaml
auth     required   pam_deny.so
account  required   pam_permit.so
session  required   pam_permit.so
