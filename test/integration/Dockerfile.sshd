# sshd integration image: a real OpenSSH server (privilege separation, fork
# model) with the module installed, authenticating `systems` through the
# device flow against the mock provider. Build from the repository root:
#   docker build -f test/integration/Dockerfile.sshd -t pam-oidc-device-sshd .
FROM debian:bookworm-slim

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends libpam0g openssh-server openssh-client sshpass sudo ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash systems && passwd -l systems \
    && mkdir -p /run/sshd \
    && ssh-keygen -A

COPY build/pam_oidc_device.so /tmp/pam_oidc_device.so
RUN dir="$(dirname "$(find /usr/lib -name pam_permit.so -print -quit)")" \
    && install -m 0644 /tmp/pam_oidc_device.so "$dir/pam_oidc_device.so" \
    && rm /tmp/pam_oidc_device.so

COPY test/integration/config.yaml   /etc/security/pam_oidc_device.yaml
COPY build/pam-oidc-device-helper /usr/libexec/pam-oidc-device/pam-oidc-device-helper
COPY build/mock-provider            /usr/local/bin/mock-provider
COPY test/integration/sshd/pam.d-sshd    /etc/pam.d/sshd
COPY test/integration/sshd/sshd_config   /etc/ssh/sshd_config.d/oidc.conf
COPY test/integration/sshd/sudoers-oidc  /etc/sudoers.d/oidc
COPY test/integration/sshd/run.sh        /run-sshd.sh
RUN chmod 0440 /etc/sudoers.d/oidc && visudo -cf /etc/sudoers.d/oidc

ENTRYPOINT ["/run-sshd.sh"]
